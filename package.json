{
  "name": "interview-question-bank",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,worker,web --prefix-colors blue,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:worker": "npm run worker:dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:unit:coverage": "npm run test:unit:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write package.json README.md .github frontend backend",
    "format:check": "prettier --check package.json README.md .github frontend backend",
    "api:types": "openapi-typescript backend/openapi/openapi.yaml -o frontend/src/shared/api/generated.ts",
    "api:types:check": "npm run api:types && git diff --exit-code -- frontend/src/shared/api/generated.ts",
    "db:start": "docker compose up -d postgres mailpit",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed:reference": "npm run db:seed:reference --workspace backend",
    "db:seed:demo": "npm run db:seed:demo --workspace backend",
    "db:seed:load": "npm run db:seed:load --workspace backend",
    "db:seed:verify": "npm run db:seed:verify --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "db:status": "npm run db:status --workspace backend"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "supabase": "^2.39.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@google/genai@2.17.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "tesseract.js@7.0.0": true
  }
}
