NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://prepvi:prepvi@localhost:5432/prepvi
DATABASE_SSL=false
DB_POOL_MAX=5
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
VITE_DEV_API_TARGET=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
CSRF_SECRET=
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PrepVI <no-reply@prepvi.local>
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.local/private-files
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OCR_LANGUAGES=vie+eng
OCR_CONCURRENCY=2
OCR_TIMEOUT_SECONDS=60
OCR_MAX_ATTEMPTS=2
DEMO_SEED_PASSWORD=
ALLOW_NON_PRODUCTION_SEED=false
VITE_ENABLE_DEMO_TOOLS=false
OPENAPI_VALIDATION=true

# Gemini AI assistance (backend only).
# Development enables every AI surface so the complete flow can be tested.
# Set AI_ENABLED=false to test the deterministic/manual fallback without Gemini.
AI_PROVIDER=gemini
AI_ENABLED=true
AI_JD_ANALYSIS_ENABLED=true
AI_RECOMMENDATION_EXPLANATION_ENABLED=true
AI_AGENDA_DRAFT_ENABLED=true
AI_FEEDBACK_DRAFT_ENABLED=true
# Required when AI_ENABLED=true. Keep this backend-only and never commit the real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_ATTEMPTS=2
GEMINI_CONCURRENCY=2
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_INPUT_TOKENS=20000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_RPM_BUDGET=12
GEMINI_TPM_BUDGET=200000
GEMINI_DAILY_REQUEST_BUDGET=450
GEMINI_DAILY_INPUT_TOKEN_BUDGET=5000000
AI_USER_DAILY_REQUEST_BUDGET=20
GEMINI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GEMINI_CIRCUIT_BREAKER_RESET_SECONDS=60
AI_RESULT_RETENTION_DAYS=30

# US-22 reminder scheduling (disabled by default for R1).
# Set to true only when the R1 Extension scope explicitly includes reminders.
BOOKING_REMINDERS_ENABLED=false

